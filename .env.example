# ==============================================================================
# Security Scanner Environment Configuration Template
# ==============================================================================
# Bu dosyayı referans alarak kendi .env dosyanızı oluşturabilirsiniz.
# UYARI: Gerçek token ve anahtarlarınızı asla git repolarına commit etmeyin.

# ─── Backend & Ortak Güvenlik Ayarları ─────────────────────────────────────────
# Zorunlu: En az 32 karakterlik rastgele bir yerel API tokenı.
SECURITY_SCANNER_API_TOKEN=generate-a-secure-random-token-at-least-32-characters-long

# İzin verilen tarayıcı Origin adresleri (virgülle ayrılmış).
SECURITY_SCANNER_ALLOWED_ORIGINS=http://127.0.0.1:5173

# Backend sunucusunun bağlanacağı IP ve port (varsayılan: 127.0.0.1:4310).
SECURITY_SCANNER_BIND_HOST=127.0.0.1
PORT=4310

# Yerel SQLite veritabanı dosya yolu.
SECURITY_SCANNER_DB_PATH=security-scanner.db

# ─── Sunucu Tarafı Host İzin Listeleri (Allowlist) ──────────────────────────────
# Aktif tarama için izin verilen exact hostname'ler (virgülle ayrılmış).
# Boş bırakıldığında aktif taramalar fail-closed reddedilir.
ALLOWED_ACTIVE_HOSTS=localhost,127.0.0.1

# Özel ağ / lab hedefleri için ek izin listeleri.
ALLOWED_ACTIVE_PRIVATE_HOSTS=
ALLOWED_PASSIVE_HOSTS=
ALLOWED_PROBE_HOSTS=
SECURITY_SCANNER_PROBE_ENABLED=false

# ─── Kaynak ve Hız Limitleri ──────────────────────────────────────────────────
# Global eşzamanlı tarama sayısı (varsayılan: 2)
SECURITY_SCANNER_MAX_CONCURRENT_SCANS=2

# Kuyrukta bekleyebilen tarama sayısı (varsayılan: 8)
SECURITY_SCANNER_MAX_QUEUED_SCANS=8

# Bellekte izlenen asenkron iş sayısı (varsayılan: 8)
SECURITY_SCANNER_MAX_ASYNC_JOBS=8

# Tarama başlangıç hız sınırı penceresi (ms) ve istek sayısı (varsayılan: 20 istek / 60 sn)
SECURITY_SCANNER_RATE_LIMIT_WINDOW_MS=60000
SECURITY_SCANNER_RATE_LIMIT_MAX=20

# Tek uzak HTTP yanıtında okunacak en fazla byte (varsayılan: 1MB = 1048576)
SECURITY_SCANNER_MAX_RESPONSE_BODY_BYTES=1048576

# Tek bir taramada hedefe gönderilebilecek azami ağ isteği (varsayılan: 128)
SECURITY_SCANNER_MAX_REQUESTS_PER_SCAN=128

# Asenkron iş zaman aşımı ve saklama süresi (ms, varsayılan: 600000 = 10 dk)
SECURITY_SCANNER_ASYNC_JOB_TTL_MS=600000

# ─── Frontend Yapılandırması ─────────────────────────────────────────────────
# Frontend'in bağlanacağı Backend API adresi (varsayılan: http://127.0.0.1:4310)
VITE_API_BASE_URL=http://127.0.0.1:4310

# ─── MCP Server Yapılandırması ────────────────────────────────────────────────
# MCP sunucusunun bağlanacağı Backend API adresi
SECURITY_SCANNER_BACKEND_URL=http://127.0.0.1:4310

# ─── Python AI Agent Yapılandırması ───────────────────────────────────────────
# İsteğe bağlı: Claude tabanlı otonom analiz ajanı için Anthropic API anahtarı
ANTHROPIC_API_KEY=
